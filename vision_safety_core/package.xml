<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vision_safety_core</name>
  <version>0.1.0</version>
  <description>
    ROS-independent C++ core of the vision safety system: HSV colour detector,
    ground-plane danger zone, and the safety monitor state machine.
  </description>
  <maintainer email="kavinaya2409@gmail.com">Kavinaya</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>libopencv-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
