<?xml version="1.0"?>
<!--
  vision_bot: minimal differential-drive robot for the vision safety project.

  Layout (top view, +x = forward):

           [camera]
     +=============+
  (L)|   base      |(R)    wheels slightly forward of centre,
     |   o caster  |       caster at the rear, so the centre of mass sits
     +=============+       inside the support triangle (no tipping on braking)

  Frames: base_footprint (on the ground) to base_link (axle height),
          then left/right_wheel_link, caster_link, camera_link, camera_link_optical
-->
<robot name="vision_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Parameters ===================== -->
  <xacro:property name="PI" value="3.14159265359"/>

  <!-- Chassis -->
  <xacro:property name="base_length" value="0.30"/>
  <xacro:property name="base_width"  value="0.20"/>
  <xacro:property name="base_height" value="0.08"/>
  <xacro:property name="base_mass"   value="2.0"/>
  <xacro:property name="base_z"      value="0.03"/>   <!-- box centre above axle -->

  <!-- Wheels -->
  <xacro:property name="wheel_radius"     value="0.05"/>
  <xacro:property name="wheel_width"      value="0.03"/>
  <xacro:property name="wheel_mass"       value="0.2"/>
  <xacro:property name="wheel_x"          value="0.04"/>
  <xacro:property name="wheel_separation" value="0.25"/>

  <!-- Caster -->
  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass"   value="0.05"/>
  <xacro:property name="caster_x"      value="-0.11"/>

  <!-- Camera: front-top, pitched slightly down to see the floor ahead -->
  <xacro:property name="camera_x"     value="0.14"/>
  <xacro:property name="camera_z"     value="0.085"/>
  <xacro:property name="camera_pitch" value="0.15"/>   <!-- rad, + = nose down -->
  <xacro:property name="camera_size"  value="0.03"/>
  <xacro:property name="camera_mass"  value="0.05"/>

  <!-- ===================== Inertia macros ===================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12}" iyz="0"
             izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+h*h)/12}" iyz="0"
             izz="${m*r*r/2}"/>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0"
             iyy="${2*m*r*r/5}" iyz="0"
             izz="${2*m*r*r/5}"/>
  </xacro:macro>

  <!-- ===================== Materials (RViz) ===================== -->
  <material name="chassis_grey"><color rgba="0.25 0.27 0.30 1.0"/></material>
  <material name="wheel_black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="camera_white"><color rgba="0.9 0.9 0.9 1.0"/></material>

  <!-- ===================== Links & joints ===================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
    </inertial>
  </link>

  <!-- Wheel macro: side = left/right, reflect = +1/-1 -->
  <xacro:macro name="wheel" params="side reflect">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${-PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${-PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${-PI/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="${wheel_x} ${reflect*wheel_separation/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel side="left"  reflect="1"/>
  <xacro:wheel side="right" reflect="-1"/>

  <!-- Caster: frictionless sphere at the rear -->
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- Camera body -->
  <link name="camera_link">
    <visual>
      <geometry><box size="${camera_size} ${camera_size*2} ${camera_size}"/></geometry>
      <material name="camera_white"/>
    </visual>
    <collision>
      <geometry><box size="${camera_size} ${camera_size*2} ${camera_size}"/></geometry>
    </collision>
    <inertial>
      <mass value="${camera_mass}"/>
      <xacro:box_inertia m="${camera_mass}" x="${camera_size}" y="${camera_size*2}" z="${camera_size}"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} 0 ${camera_z}" rpy="0 ${camera_pitch} 0"/>
  </joint>

  <!-- Optical frame (z forward, x right, y down): the frame images are expressed in -->
  <link name="camera_link_optical"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- ===================== Gazebo: camera sensor ===================== -->
  <!-- Gazebo cameras look along +x of their link, so the sensor sits on
       camera_link; gz_frame_id stamps images with the optical frame. -->
  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>/vision_bot/camera/image_raw</topic>
      <gz_frame_id>camera_link_optical</gz_frame_id>
      <camera name="front_camera">
        <camera_info_topic>/vision_bot/camera/camera_info</camera_info_topic>
        <horizontal_fov>1.047</horizontal_fov>   <!-- 60 deg -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- ===================== Gazebo: drive + joint states ===================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <!-- Limits shape the stopping distance, which we will measure later -->
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.3</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>

      <topic>/vision_bot/cmd_vel</topic>
      <odom_topic>/vision_bot/odom</odom_topic>
      <tf_topic>/vision_bot/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/vision_bot/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
