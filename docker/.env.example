# Create docker/.env from this file, or generate it in one step:
#
#   cd docker
#   printf "HOST_USER=%s\nHOST_UID=%s\nHOST_GID=%s\nCOMPOSE_FILE=docker-compose.yml:gpu-nvidia.yml\n" \
#     "$(id -un)" "$(id -u)" "$(id -g)" > .env
#
# Container user = your host user, so workspace files stay owned by you.
HOST_USER=dev
HOST_UID=1000
HOST_GID=1000

# GPU: NVIDIA -> gpu-nvidia.yml, Intel/AMD -> gpu-dri.yml,
# no GPU -> docker-compose.yml alone (software rendering: slow but works).
COMPOSE_FILE=docker-compose.yml:gpu-nvidia.yml
